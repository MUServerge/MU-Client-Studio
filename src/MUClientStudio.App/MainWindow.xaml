<Window x:Class="MUClientStudio.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MU Client Studio" Width="1440" Height="900" MinWidth="1180" MinHeight="720"
        Background="{StaticResource Bg}" WindowStartupLocation="CenterScreen">
    <Grid Background="{StaticResource Bg}">
        <Grid.RowDefinitions>
            <RowDefinition Height="58"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="34"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#090E14" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
            <Grid Margin="16,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="260"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="30" Height="30" BorderBrush="#40536D" BorderThickness="1" RenderTransformOrigin="0.5,0.5" Margin="0,0,12,0">
                        <Border.RenderTransform><RotateTransform Angle="45"/></Border.RenderTransform>
                        <Border Margin="7" BorderBrush="{StaticResource Gold}" BorderThickness="1"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="MU CLIENT STUDIO" FontSize="13" FontWeight="SemiBold" CharacterSpacing="120"/>
                        <TextBlock Text="MU PROJECT OS / PLAYER WORKSPACE" Foreground="#68778B" FontSize="8" Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Border Background="#0A1016" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="7" Padding="9,5" Margin="3,0">
                        <TextBlock FontSize="9"><Run Text="PROFILE  "/><Run Text="Louis S6" Foreground="#D8E2EE"/></TextBlock>
                    </Border>
                    <Border Background="#0A1016" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="7" Padding="9,5" Margin="3,0">
                        <TextBlock FontSize="9"><Run Text="MODULE  "/><Run Text="Player" Foreground="#D8E2EE"/></TextBlock>
                    </Border>
                    <Border Background="#0A1016" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="7" Padding="9,5" Margin="3,0">
                        <TextBlock FontSize="9"><Run Text="RUNTIME  "/><Run Text="Native WPF" Foreground="#D8E2EE"/></TextBlock>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource ToolButton}" Content="Refresh" Click="Refresh_Click" Margin="0,0,8,0"/>
                    <Button Style="{StaticResource ToolButton}" Content="Open Client" Click="OpenClient_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main shell -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="190"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="260"/>
            </Grid.ColumnDefinitions>

            <!-- Left navigation -->
            <Border Grid.Column="0" Background="#090E14" BorderBrush="#1F2A39" BorderThickness="0,0,1,0">
                <Grid Margin="10,12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Background="#0D141D" BorderBrush="#28384D" BorderThickness="1" CornerRadius="9" Padding="10" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="ACTIVE CLIENT" Foreground="#64758A" FontSize="8" CharacterSpacing="130"/>
                            <TextBlock x:Name="ClientNameText" Text="No client loaded" FontSize="11" FontWeight="SemiBold" Margin="0,6,0,0" TextTrimming="CharacterEllipsis"/>
                            <TextBlock x:Name="ClientPathText" Text="Open a MU client root or Data folder" Foreground="#718095" FontSize="8" Margin="0,4,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <TextBlock Grid.Row="1" Text="PLAYER" Foreground="#5F6E82" FontSize="8" CharacterSpacing="160" Margin="8,0,0,7"/>
                    <StackPanel Grid.Row="2">
                        <Button Style="{StaticResource NavButton}" Background="#121B28" BorderBrush="#2A3B52" Foreground="White" Content="●   Character"/>
                        <Button Style="{StaticResource NavButton}" Content="○   Equipment"/>
                        <Button Style="{StaticResource NavButton}" Content="○   Animations"/>
                        <Button Style="{StaticResource NavButton}" Content="○   Materials"/>
                        <Button Style="{StaticResource NavButton}" Content="○   Diagnostics"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Workspace -->
            <Grid Grid.Column="1" Background="#070B10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="64"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="190"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="#0A0F15" BorderBrush="#1F2A39" BorderThickness="0,0,0,1">
                    <Grid Margin="16,0">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="PLAYER / CHARACTER" Foreground="#6D7C90" FontSize="8" CharacterSpacing="150"/>
                            <TextBlock Text="Character Workspace" FontSize="20" FontWeight="SemiBold" Margin="0,3,0,0"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <ComboBox x:Name="ClassCombo" Width="150" Height="30" Background="#0A1016" Foreground="White" BorderBrush="{StaticResource Line}" SelectionChanged="ClassCombo_SelectionChanged"/>
                            <ComboBox x:Name="AnimationCombo" Width="150" Height="30" Margin="8,0,0,0" Background="#0A1016" Foreground="White" BorderBrush="{StaticResource Line}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid Grid.Row="1" Margin="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="300"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="#080D13" BorderBrush="#263548" BorderThickness="1" CornerRadius="10" Margin="0,0,10,0">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="42"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <Border Grid.Row="0" BorderBrush="#1F2A39" BorderThickness="0,0,0,1">
                                <Grid Margin="12,0">
                                    <TextBlock Text="VIEWPORT" Foreground="#6C7C90" FontSize="8" CharacterSpacing="150" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="ViewportStatusText" Text="Waiting for client Data" Foreground="#718095" FontSize="9" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                            <Grid Grid.Row="1">
                                <Border Width="220" Height="320" HorizontalAlignment="Center" VerticalAlignment="Center" BorderBrush="#24364A" BorderThickness="1" CornerRadius="14" Background="#0A1119">
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <TextBlock Text="PLAYER" Foreground="#41546B" FontSize="34" FontWeight="Bold" HorizontalAlignment="Center"/>
                                        <TextBlock Text="BMD renderer stage" Foreground="#65768B" FontSize="10" Margin="0,8,0,0" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Xulek-first pipeline" Foreground="#43576D" FontSize="8" Margin="0,4,0,0" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Grid>
                    </Border>

                    <Border Grid.Column="1" Background="#0B1118" BorderBrush="#263548" BorderThickness="1" CornerRadius="10">
                        <Grid Margin="12">
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <TextBlock Text="EQUIPMENT" Foreground="#6D7C90" FontSize="8" CharacterSpacing="150" Margin="2,2,0,9"/>
                            <UniformGrid Grid.Row="1" Columns="2" Rows="4">
                                <Button Style="{StaticResource ToolButton}" Content="Helm" Margin="4"/>
                                <Button Style="{StaticResource ToolButton}" Content="Armor" Margin="4"/>
                                <Button Style="{StaticResource ToolButton}" Content="Pants" Margin="4"/>
                                <Button Style="{StaticResource ToolButton}" Content="Gloves" Margin="4"/>
                                <Button Style="{StaticResource ToolButton}" Content="Boots" Margin="4"/>
                                <Button Style="{StaticResource ToolButton}" Content="Left Weapon" Margin="4"/>
                                <Button Style="{StaticResource ToolButton}" Content="Right Weapon" Margin="4"/>
                                <Button Style="{StaticResource ToolButton}" Content="Wings" Margin="4"/>
                            </UniformGrid>
                        </Grid>
                    </Border>
                </Grid>

                <Border Grid.Row="2" Margin="12,0,12,12" Background="#0B1118" BorderBrush="#263548" BorderThickness="1" CornerRadius="10">
                    <Grid Margin="14,10">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="MODEL" Foreground="#637286" FontSize="8" CharacterSpacing="140"/>
                            <TextBlock x:Name="ModelPathText" Text="—" FontSize="11" Margin="0,6,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="SKELETON" Foreground="#637286" FontSize="8" CharacterSpacing="140"/>
                            <TextBlock Text="Bones 33 / 42 / 47 reserved for attachments" FontSize="11" Margin="0,6,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="ANIMATION" Foreground="#637286" FontSize="8" CharacterSpacing="140"/>
                            <TextBlock Text="24 FPS source timing" FontSize="11" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- Inspector -->
            <Border Grid.Column="2" Background="#090E14" BorderBrush="#1F2A39" BorderThickness="1,0,0,0">
                <StackPanel Margin="14,14">
                    <TextBlock Text="INSPECTOR" Foreground="#5F6E82" FontSize="8" CharacterSpacing="160"/>
                    <TextBlock Text="Player state" FontSize="12" FontWeight="SemiBold" Margin="0,7,0,14"/>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="28"/><RowDefinition Height="28"/><RowDefinition Height="28"/><RowDefinition Height="28"/><RowDefinition Height="28"/><RowDefinition Height="28"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="Status" Foreground="#65758A" FontSize="9"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" x:Name="InspectorStatusText" Text="Waiting" FontSize="9" HorizontalAlignment="Right"/>
                        <TextBlock Grid.Row="1" Text="Class" Foreground="#65758A" FontSize="9"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" x:Name="InspectorClassText" Text="Dark Wizard" FontSize="9" HorizontalAlignment="Right"/>
                        <TextBlock Grid.Row="2" Text="Data root" Foreground="#65758A" FontSize="9"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" x:Name="InspectorDataText" Text="Not loaded" FontSize="9" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" Width="140"/>
                        <TextBlock Grid.Row="3" Text="Files" Foreground="#65758A" FontSize="9"/>
                        <TextBlock Grid.Row="3" Grid.Column="1" x:Name="InspectorFilesText" Text="—" FontSize="9" HorizontalAlignment="Right"/>
                        <TextBlock Grid.Row="4" Text="Wing bone" Foreground="#65758A" FontSize="9"/>
                        <TextBlock Grid.Row="4" Grid.Column="1" Text="47" FontSize="9" HorizontalAlignment="Right"/>
                        <TextBlock Grid.Row="5" Text="Weapon bones" Foreground="#65758A" FontSize="9"/>
                        <TextBlock Grid.Row="5" Grid.Column="1" Text="33 / 42" FontSize="9" HorizontalAlignment="Right"/>
                    </Grid>
                    <Border Height="1" Background="#1F2A39" Margin="0,10,0,14"/>
                    <TextBlock Text="SOURCE CONTRACT" Foreground="#5F6E82" FontSize="8" CharacterSpacing="150"/>
                    <TextBlock Text="Xulek primary reference" FontSize="10" Margin="0,8,0,0"/>
                    <TextBlock Text="Main_EX603 legacy validation" Foreground="#748397" FontSize="9" Margin="0,4,0,0"/>
                    <TextBlock Text="No invented BMD semantics" Foreground="{StaticResource Green}" FontSize="9" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Footer -->
        <Border Grid.Row="2" Background="#070A0F" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0">
            <Grid Margin="14,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="PLAYER" Foreground="#68778C" FontSize="8"/>
                    <TextBlock Text="  •  " Foreground="#3F4E61"/>
                    <TextBlock x:Name="FooterClientText" Text="NO CLIENT" Foreground="#B9C5D4" FontSize="8"/>
                    <TextBlock Text="  •  " Foreground="#3F4E61"/>
                    <TextBlock x:Name="FooterStateText" Text="WAITING" Foreground="#68778C" FontSize="8"/>
                </StackPanel>
                <TextBlock Text=".NET 8 / WPF / WIN-X64" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="#68778C" FontSize="8"/>
            </Grid>
        </Border>
    </Grid>
</Window>
