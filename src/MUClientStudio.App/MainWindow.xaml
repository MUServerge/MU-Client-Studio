<Window x:Class="MUClientStudio.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MU Client Studio" Width="1440" Height="900" MinWidth="1180" MinHeight="720"
        Background="{StaticResource Bg}" WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style x:Key="EquipmentSlotButton" TargetType="Button">
            <Setter Property="Foreground" Value="#D8E2EE"/>
            <Setter Property="Background" Value="#080E15"/>
            <Setter Property="BorderBrush" Value="#2A3A50"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="SlotBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7">
                            <Grid Margin="7">
                                <TextBlock Text="{TemplateBinding Tag}"
                                           Foreground="#34475E"
                                           FontSize="8"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Left"
                                           VerticalAlignment="Top"/>
                                <TextBlock Text="◇"
                                           Foreground="#26394F"
                                           FontSize="22"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                                <Border VerticalAlignment="Bottom"
                                        Background="#0D151F"
                                        BorderBrush="#223247"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        Padding="4,3">
                                    <TextBlock Text="{TemplateBinding Content}"
                                               Foreground="{TemplateBinding Foreground}"
                                               FontSize="8"
                                               TextAlignment="Center"
                                               TextTrimming="CharacterEllipsis"
                                               HorizontalAlignment="Stretch"/>
                                </Border>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="SlotBorder" Property="Background" Value="#0E1722"/>
                                <Setter TargetName="SlotBorder" Property="BorderBrush" Value="#425A77"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="SlotBorder" Property="Background" Value="#132033"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Background="{StaticResource Bg}">
        <Grid.RowDefinitions>
            <RowDefinition Height="58"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="34"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#090E14" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
            <Grid Margin="16,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="260"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="30" Height="30" BorderBrush="#40536D" BorderThickness="1" RenderTransformOrigin="0.5,0.5" Margin="0,0,12,0">
                        <Border.RenderTransform><RotateTransform Angle="45"/></Border.RenderTransform>
                        <Border Margin="7" BorderBrush="{StaticResource Gold}" BorderThickness="1"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="MU CLIENT STUDIO" FontSize="13" FontWeight="SemiBold"/>
                        <TextBlock Text="MU PROJECT OS / PLAYER WORKSPACE" Foreground="#68778B" FontSize="8" Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Border Background="#0A1016" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="7" Padding="9,5" Margin="3,0"><TextBlock FontSize="9"><Run Text="PROFILE  "/><Run Text="Louis S6" Foreground="#D8E2EE"/></TextBlock></Border>
                    <Border Background="#0A1016" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="7" Padding="9,5" Margin="3,0"><TextBlock FontSize="9"><Run Text="MODULE  "/><Run Text="Player" Foreground="#D8E2EE"/></TextBlock></Border>
                    <Border Background="#0A1016" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="7" Padding="9,5" Margin="3,0"><TextBlock FontSize="9"><Run Text="RUNTIME  "/><Run Text="Native WPF" Foreground="#D8E2EE"/></TextBlock></Border>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource ToolButton}" Content="Refresh" Click="Refresh_Click" Margin="0,0,8,0"/>
                    <Button Style="{StaticResource ToolButton}" Content="Open Client" Click="OpenClient_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="*"/><ColumnDefinition Width="260"/></Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="#090E14" BorderBrush="#1F2A39" BorderThickness="0,0,1,0">
                <Grid Margin="10,12">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Border Grid.Row="0" Background="#0D141D" BorderBrush="#28384D" BorderThickness="1" CornerRadius="9" Padding="10" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="ACTIVE CLIENT" Foreground="#64758A" FontSize="8"/>
                            <TextBlock x:Name="ClientNameText" Text="No client loaded" FontSize="11" FontWeight="SemiBold" Margin="0,6,0,0" TextTrimming="CharacterEllipsis"/>
                            <TextBlock x:Name="ClientPathText" Text="Open a MU client root or Data folder" Foreground="#718095" FontSize="8" Margin="0,4,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                    <TextBlock Grid.Row="1" Text="PLAYER" Foreground="#5F6E82" FontSize="8" Margin="8,0,0,7"/>
                    <StackPanel Grid.Row="2">
                        <Button Style="{StaticResource NavButton}" Background="#121B28" BorderBrush="#2A3B52" Foreground="White" Content="●   Character"/>
                        <Button Style="{StaticResource NavButton}" Content="○   Equipment"/>
                        <Button Style="{StaticResource NavButton}" Content="○   Animations"/>
                        <Button Style="{StaticResource NavButton}" Content="○   Materials"/>
                        <Button Style="{StaticResource NavButton}" Content="○   Diagnostics"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Column="1" Background="#070B10">
                <Grid.RowDefinitions><RowDefinition Height="64"/><RowDefinition Height="*"/><RowDefinition Height="150"/></Grid.RowDefinitions>
                <Border Grid.Row="0" Background="#0A0F15" BorderBrush="#1F2A39" BorderThickness="0,0,0,1">
                    <Grid Margin="16,0">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="PLAYER / CHARACTER" Foreground="#6D7C90" FontSize="8"/>
                            <TextBlock Text="Character Workspace" FontSize="20" FontWeight="SemiBold" Margin="0,3,0,0"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <ComboBox x:Name="ClassCombo" Width="150" Height="30" Style="{StaticResource V6ComboBox}" SelectionChanged="ClassCombo_SelectionChanged"/>
                            <ComboBox x:Name="AnimationCombo" Width="150" Height="30" Margin="8,0,0,0" Style="{StaticResource V6ComboBox}" IsEnabled="False" SelectionChanged="AnimationCombo_SelectionChanged"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid Grid.Row="1" Margin="12">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="270"/></Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="#080D13" BorderBrush="#263548" BorderThickness="1" CornerRadius="10" Margin="0,0,10,0" ClipToBounds="True">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="42"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <Border Grid.Row="0" BorderBrush="#1F2A39" BorderThickness="0,0,0,1">
                                <Grid Margin="12,0">
                                    <TextBlock Text="VIEWPORT" Foreground="#6C7C90" FontSize="8" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="ViewportStatusText" Text="Waiting for client Data" Foreground="#718095" FontSize="9" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>

                            <Grid Grid.Row="1" Background="#080D13">
                                <Viewport3D x:Name="PlayerViewport" ClipToBounds="True" MouseWheel="PlayerViewport_MouseWheel">
                                    <Viewport3D.Camera>
                                        <PerspectiveCamera x:Name="PlayerCamera"
                                                           Position="0,0,320"
                                                           LookDirection="0,0,-320"
                                                           UpDirection="0,1,0"
                                                           FieldOfView="38"
                                                           NearPlaneDistance="0.1"
                                                           FarPlaneDistance="100000"/>
                                    </Viewport3D.Camera>
                                    <ModelVisual3D>
                                        <ModelVisual3D.Content>
                                            <Model3DGroup>
                                                <AmbientLight Color="#777D86"/>
                                                <DirectionalLight Color="#E8EDF4" Direction="-0.35,-0.45,-1"/>
                                                <DirectionalLight Color="#66788F" Direction="0.8,0.15,0.45"/>
                                            </Model3DGroup>
                                        </ModelVisual3D.Content>
                                    </ModelVisual3D>
                                    <ModelVisual3D x:Name="PlayerModelVisual"/>
                                </Viewport3D>

                                <Border x:Name="ViewportPlaceholder"
                                        Width="280" Height="320"
                                        HorizontalAlignment="Center" VerticalAlignment="Center"
                                        BorderBrush="#24364A" BorderThickness="1" CornerRadius="14"
                                        Background="#0A1119">
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="18">
                                        <TextBlock x:Name="ViewportModelNameText" Text="PLAYER" Foreground="#41546B" FontSize="30" FontWeight="Bold" HorizontalAlignment="Center" TextAlignment="Center"/>
                                        <TextBlock x:Name="ViewportModelInfoText" Text="Waiting for a real BMD model" Foreground="#65768B" FontSize="10" Margin="0,10,0,0" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/>
                                        <TextBlock x:Name="ViewportModelDetailText" Text="Main_EX603 → Xulek implementation reference" Foreground="#43576D" FontSize="8" Margin="0,5,0,0" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Grid>
                    </Border>

                    <Border Grid.Column="1" Background="#0B1118" BorderBrush="#263548" BorderThickness="1" CornerRadius="10">
                        <Grid Margin="12">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="2,1,2,10">
                                <StackPanel>
                                    <TextBlock Text="EQUIPMENT" Foreground="#6D7C90" FontSize="8"/>
                                    <TextBlock Text="Character loadout" FontSize="12" FontWeight="SemiBold" Margin="0,4,0,0"/>
                                </StackPanel>
                                <TextBlock x:Name="EquipmentCatalogStateText" Text="BASE"
                                           Foreground="#53667D"
                                           FontSize="8"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Bottom"/>
                            </Grid>

                            <Grid Grid.Row="1" Height="360" VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="72"/>
                                    <RowDefinition Height="104"/>
                                    <RowDefinition Height="104"/>
                                    <RowDefinition Height="72"/>
                                </Grid.RowDefinitions>

                                <Button x:Name="HelmSlotButton" Grid.Row="0" Grid.Column="1" Style="{StaticResource EquipmentSlotButton}" Tag="HEAD" Content="Base Helm" CommandParameter="Helm" Click="EquipmentSlot_Click" Margin="4"/>
                                <Button x:Name="WingsSlotButton" Grid.Row="0" Grid.Column="2" Style="{StaticResource EquipmentSlotButton}" Tag="BACK" Content="Wings" CommandParameter="Wings" Click="EquipmentSlot_Click" Margin="4"/>

                                <Button x:Name="LeftWeaponSlotButton" Grid.Row="1" Grid.RowSpan="2" Grid.Column="0" Style="{StaticResource EquipmentSlotButton}" Tag="HAND L" Content="Left Weapon" CommandParameter="LeftWeapon" Click="EquipmentSlot_Click" Margin="4"/>
                                <Button x:Name="ArmorSlotButton" Grid.Row="1" Grid.Column="1" Style="{StaticResource EquipmentSlotButton}" Tag="BODY" Content="Base Armor" CommandParameter="Armor" Click="EquipmentSlot_Click" Margin="4"/>
                                <Button x:Name="RightWeaponSlotButton" Grid.Row="1" Grid.RowSpan="2" Grid.Column="2" Style="{StaticResource EquipmentSlotButton}" Tag="HAND R" Content="Right Weapon" CommandParameter="RightWeapon" Click="EquipmentSlot_Click" Margin="4"/>
                                <Button x:Name="PantsSlotButton" Grid.Row="2" Grid.Column="1" Style="{StaticResource EquipmentSlotButton}" Tag="LEGS" Content="Base Pants" CommandParameter="Pants" Click="EquipmentSlot_Click" Margin="4"/>

                                <Button x:Name="GlovesSlotButton" Grid.Row="3" Grid.Column="0" Style="{StaticResource EquipmentSlotButton}" Tag="HANDS" Content="Base Gloves" CommandParameter="Gloves" Click="EquipmentSlot_Click" Margin="4"/>
                                <Button x:Name="BootsSlotButton" Grid.Row="3" Grid.Column="2" Style="{StaticResource EquipmentSlotButton}" Tag="FEET" Content="Base Boots" CommandParameter="Boots" Click="EquipmentSlot_Click" Margin="4"/>

                                <Border Grid.Row="3" Grid.Column="1" Margin="4" Background="#080E15" BorderBrush="#1E2D40" BorderThickness="1" CornerRadius="7">
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="ITEM" Foreground="#30445B" FontSize="8" HorizontalAlignment="Center"/>
                                        <TextBlock Text="LOADOUT" Foreground="#435970" FontSize="8" FontWeight="SemiBold" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <Border Grid.Row="2" Background="#091018" BorderBrush="#1F2E42" BorderThickness="1" CornerRadius="6" Padding="8,6" Margin="2,10,2,1">
                                <Grid>
                                    <TextBlock Text="Click a slot to equip" Foreground="#607187" FontSize="8"/>
                                    <TextBlock x:Name="EquipmentCatalogSummaryText" Text="Local/item.bmd" Foreground="#53667D" FontSize="8" HorizontalAlignment="Right"/>
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>

                <Border Grid.Row="2" Margin="12,0,12,12" Background="#0B1118" BorderBrush="#263548" BorderThickness="1" CornerRadius="10">
                    <Grid Margin="14,10">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0"><TextBlock Text="MODEL" Foreground="#637286" FontSize="8"/><TextBlock x:Name="ModelSummaryText" Text="—" FontSize="11" Margin="0,6,0,0"/><TextBlock x:Name="ModelPathText" Text="—" Foreground="#637286" FontSize="8" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/></StackPanel>
                        <StackPanel Grid.Column="1"><TextBlock Text="SKELETON" Foreground="#637286" FontSize="8"/><TextBlock x:Name="SkeletonSummaryText" Text="Bones 33 / 42 / 47 attachments" FontSize="11" Margin="0,6,0,0"/></StackPanel>
                        <StackPanel Grid.Column="2"><TextBlock Text="ANIMATION" Foreground="#637286" FontSize="8"/><TextBlock x:Name="AnimationSummaryText" Text="24 FPS source timing" FontSize="11" Margin="0,6,0,0"/></StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <Border Grid.Column="2" Background="#090E14" BorderBrush="#1F2A39" BorderThickness="1,0,0,0">
                <StackPanel Margin="14">
                    <TextBlock Text="INSPECTOR" Foreground="#5F6E82" FontSize="8"/>
                    <TextBlock Text="Player state" FontSize="12" FontWeight="SemiBold" Margin="0,7,0,14"/>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="28"/><RowDefinition Height="28"/><RowDefinition Height="28"/><RowDefinition Height="28"/>
                            <RowDefinition Height="28"/><RowDefinition Height="28"/><RowDefinition Height="28"/><RowDefinition Height="28"/><RowDefinition Height="28"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="Status" Foreground="#65758A" FontSize="9"/><TextBlock Grid.Row="0" Grid.Column="1" x:Name="InspectorStatusText" Text="Waiting" FontSize="9" HorizontalAlignment="Right"/>
                        <TextBlock Grid.Row="1" Text="Class" Foreground="#65758A" FontSize="9"/><TextBlock Grid.Row="1" Grid.Column="1" x:Name="InspectorClassText" Text="Dark Wizard" FontSize="9" HorizontalAlignment="Right"/>
                        <TextBlock Grid.Row="2" Text="Data root" Foreground="#65758A" FontSize="9"/><TextBlock Grid.Row="2" Grid.Column="1" x:Name="InspectorDataText" Text="Not loaded" FontSize="9" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" Width="140"/>
                        <TextBlock Grid.Row="3" Text="Files" Foreground="#65758A" FontSize="9"/><TextBlock Grid.Row="3" Grid.Column="1" x:Name="InspectorFilesText" Text="—" FontSize="9" HorizontalAlignment="Right"/>
                        <TextBlock Grid.Row="4" Text="BMD version" Foreground="#65758A" FontSize="9"/><TextBlock Grid.Row="4" Grid.Column="1" x:Name="InspectorBmdVersionText" Text="—" FontSize="9" HorizontalAlignment="Right"/>
                        <TextBlock Grid.Row="5" Text="Meshes" Foreground="#65758A" FontSize="9"/><TextBlock Grid.Row="5" Grid.Column="1" x:Name="InspectorMeshesText" Text="—" FontSize="9" HorizontalAlignment="Right"/>
                        <TextBlock Grid.Row="6" Text="Bones" Foreground="#65758A" FontSize="9"/><TextBlock Grid.Row="6" Grid.Column="1" x:Name="InspectorBonesText" Text="—" FontSize="9" HorizontalAlignment="Right"/>
                        <TextBlock Grid.Row="7" Text="Actions" Foreground="#65758A" FontSize="9"/><TextBlock Grid.Row="7" Grid.Column="1" x:Name="InspectorActionsText" Text="—" FontSize="9" HorizontalAlignment="Right"/>
                        <TextBlock Grid.Row="8" Text="Attach bones" Foreground="#65758A" FontSize="9"/><TextBlock Grid.Row="8" Grid.Column="1" Text="33 / 42 / 47" FontSize="9" HorizontalAlignment="Right"/>
                    </Grid>
                    <Border Height="1" Background="#1F2A39" Margin="0,10,0,14"/>
                    <TextBlock Text="SOURCE CONTRACT" Foreground="#5F6E82" FontSize="8"/>
                    <TextBlock Text="Main_EX603 primary reference" FontSize="10" Margin="0,8,0,0"/>
                    <TextBlock Text="Xulek BMD / rendering implementation" Foreground="#748397" FontSize="9" Margin="0,4,0,0"/>
                    <TextBlock Text="Main5.2 cross-check only" Foreground="#748397" FontSize="9" Margin="0,4,0,0"/>
                    <TextBlock Text="No invented BMD semantics" Foreground="{StaticResource Green}" FontSize="9" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="2" Background="#070A0F" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0">
            <Grid Margin="14,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="PLAYER" Foreground="#68778C" FontSize="8"/><TextBlock Text="  •  " Foreground="#3F4E61"/>
                    <TextBlock x:Name="FooterClientText" Text="NO CLIENT" Foreground="#B9C5D4" FontSize="8"/><TextBlock Text="  •  " Foreground="#3F4E61"/>
                    <TextBlock x:Name="FooterStateText" Text="WAITING" Foreground="#68778C" FontSize="8"/>
                </StackPanel>
                <TextBlock Text=".NET 8 / WPF / WIN-X64" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="#68778C" FontSize="8"/>
            </Grid>
        </Border>
    </Grid>
</Window>